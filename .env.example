# Copy to .env (local) and .dev.vars (Wrangler). Never commit either file.
PAYMENTS_MODE=mock
SMS_MODE=mock
# Deprecated: mock opt-in only; explicit modes take precedence.
DEMO_MODE=true
PUBLIC_SITE_URL=http://localhost:5173
GEOCODER_URL=https://photon.komoot.io
ADMIN_PHONE=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYMENT_CALLBACKS_READY=false
PAYME_SUBSCRIBE_ID=
PAYME_SUBSCRIBE_KEY=
SUBSCRIBE_PAYMENTS_READY=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Google Maps browser key: restrict to your domains and Maps JavaScript API
GOOGLE_MAPS_BROWSER_KEY=
# Require SMS for registration and commerce. Reset always requires SMS.
SMS_REQUIRED=false

# Optional pickup SMS reminders (separate from login Verify SMS)
REMINDER_SMS_READY=false
TWILIO_MESSAGING_SERVICE_SID=
